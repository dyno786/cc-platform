{%- comment -%}
  CC: App banner. A bar that slides up from the bottom on phones a moment after the page loads,
  inviting shoppers to download the CC Hair & Beauty app. Add it once, in the Footer group, so it shows on every page.
  Closing it hides it for the number of days set below. Not shown on the app page itself.
{%- endcomment -%}
{%- liquid
  assign ios = section.settings.ios_url | default: 'https://apps.apple.com/gb/app/id1591623552'
  assign hide_here = false
  if request.page_type == 'page' and page.handle == 'app'
    assign hide_here = true
  endif
-%}
{%- if section.settings.enable and hide_here == false -%}
<style>
  #ccab-{{ section.id }}{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:flex;justify-content:center;
    padding:0 max(12px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(12px,env(safe-area-inset-left,0px));
    pointer-events:none;transform:translateY(130%);transition:transform .45s cubic-bezier(.2,.9,.25,1)}
  #ccab-{{ section.id }}.is-on{transform:none}
  #ccab-{{ section.id }}[hidden]{display:none!important}
  #ccab-{{ section.id }} .ccab{pointer-events:auto;position:relative;width:100%;max-width:520px;background:{{ section.settings.bg }};color:#fff;
    border-radius:18px;padding:12px 14px;display:grid;grid-template-columns:56px 1fr auto;gap:12px;align-items:center;
    box-shadow:0 12px 34px rgba(0,0,0,.35);font-family:inherit}
  #ccab-{{ section.id }} .ccab-ic{width:56px;height:56px;border-radius:14px;overflow:hidden;background:{{ section.settings.accent }};
    display:flex;align-items:center;justify-content:center;border:2px solid rgba(255,255,255,.14)}
  #ccab-{{ section.id }} .ccab-ic img{width:100%;height:100%;object-fit:cover;display:block}
  #ccab-{{ section.id }} .ccab-ic b{font-size:22px;font-weight:900;letter-spacing:-.5px;color:#fff;line-height:1}
  #ccab-{{ section.id }} .ccab-t{margin:0;font-size:17px;font-weight:800;line-height:1.2;color:#fff}
  #ccab-{{ section.id }} .ccab-s{margin:3px 0 0;font-size:13.5px;line-height:1.3;color:rgba(255,255,255,.82)}
  #ccab-{{ section.id }} .ccab-go{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:{{ section.settings.accent }};color:#fff!important;
    text-decoration:none!important;font-weight:800;font-size:14px;border-radius:999px;padding:11px 16px;border:1px solid rgba(255,255,255,.25)}
  #ccab-{{ section.id }} .ccab-go:focus-visible,#ccab-{{ section.id }} .ccab-x:focus-visible{outline:3px solid #fff;outline-offset:2px}
  #ccab-{{ section.id }} .ccab-x{position:absolute;top:-12px;right:-6px;width:32px;height:32px;border-radius:50%;background:#fff;color:#111;border:0;
    display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(0,0,0,.25);cursor:pointer;padding:0}
  #ccab-{{ section.id }} .ccab-x svg{width:14px;height:14px}
  @media (max-width:359px){#ccab-{{ section.id }} .ccab{grid-template-columns:46px 1fr auto;gap:9px}#ccab-{{ section.id }} .ccab-ic{width:46px;height:46px}#ccab-{{ section.id }} .ccab-go{padding:10px 12px}}
  @media (prefers-reduced-motion:reduce){#ccab-{{ section.id }}{transition:none}}
</style>
<div id="ccab-{{ section.id }}" hidden role="region" aria-label="Get the {{ shop.name | escape }} app">
  <div class="ccab">
    <div class="ccab-ic" aria-hidden="true">
      {%- if section.settings.icon != blank -%}
        {{ section.settings.icon | image_url: width: 160 | image_tag: alt: '', width: 56, height: 56, loading: 'lazy' }}
      {%- else -%}<b>CC</b>{%- endif -%}
    </div>
    <div>
      <p class="ccab-t">{{ section.settings.title | escape }}</p>
      {%- if section.settings.text != blank -%}<p class="ccab-s">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <a class="ccab-go" href="{{ ios }}" target="_blank" rel="noopener" data-ccab-go>{{ section.settings.button | escape }}</a>
    <button type="button" class="ccab-x" aria-label="Close" data-ccab-x>
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 1.5l11 11M12.5 1.5l-11 11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>
<script>
(function(){
  var el=document.getElementById('ccab-{{ section.id }}'); if(!el) return;
  if(window.Shopify && Shopify.designMode){ el.hidden=false; el.classList.add('is-on'); return; } /* always visible in the theme editor */
  var ua=navigator.userAgent||'';
  var ios=/iPhone|iPod/.test(ua)||(/iPad/.test(ua))||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
  var who='{{ section.settings.show_to }}';
  var phone=window.matchMedia('(max-width: 900px)').matches;
  if(who==='ios' && !ios) return;
  if(who==='mobile' && !phone) return;
  if(window.navigator.standalone) return; /* opened from the home screen */
  var KEY='cc-app-banner-hide', days={{ section.settings.hide_days | default: 7 }};
  try{ var until=+localStorage.getItem(KEY)||0; if(until>Date.now()) return; }catch(e){}
  function hide(d){ el.classList.remove('is-on'); setTimeout(function(){el.hidden=true},500);
    try{ localStorage.setItem(KEY, String(Date.now()+d*86400000)); }catch(e){} }
  el.querySelector('[data-ccab-x]').addEventListener('click',function(){ hide(days); });
  el.querySelector('[data-ccab-go]').addEventListener('click',function(){ hide(30); });
  setTimeout(function(){ el.hidden=false; requestAnimationFrame(function(){ requestAnimationFrame(function(){ el.classList.add('is-on'); }); }); }, {{ section.settings.delay | times: 1000 }});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "CC: App banner",
  "class": "cc-app-banner-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show the app banner", "default": true },
    { "type": "image_picker", "id": "icon", "label": "App icon", "info": "Square image. Leave empty to show a red CC tile." },
    { "type": "text", "id": "title", "label": "Heading", "default": "Get the CC app" },
    { "type": "text", "id": "text", "label": "Line underneath", "default": "Hear about new arrivals and offers first" },
    { "type": "text", "id": "button", "label": "Button", "default": "Get the app" },
    { "type": "url", "id": "ios_url", "label": "App Store link", "info": "Leave empty to use the CC Hair & Beauty app on the App Store." },
    { "type": "select", "id": "show_to", "label": "Who sees it", "default": "ios", "options": [
      { "value": "ios", "label": "iPhone and iPad only" },
      { "value": "mobile", "label": "All phones and tablets" },
      { "value": "all", "label": "Everyone" } ] },
    { "type": "range", "id": "delay", "label": "Seconds before it appears", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "range", "id": "hide_days", "label": "Days hidden after closing", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 },
    { "type": "color", "id": "bg", "label": "Bar colour", "default": "#111111" },
    { "type": "color", "id": "accent", "label": "Button and tile colour", "default": "#C8322E" }
  ],
  "presets": [ { "name": "CC: App banner" } ]
}
{% endschema %}
