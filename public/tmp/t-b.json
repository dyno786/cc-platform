t-size: 14px; font-weight: 600; color: #c8322b; }\n  .ccw__eyebrow::before { content: \"\"; width: 22px; height: 2px; background: #c8322b; border-radius: 2px; }\n  .ccw h2 { margin: 0; font-size: 28px; line-height: 1.15; letter-spacing: -.01em; text-wrap: balance; }\n  .ccw__lead { margin: 12px 0 0; max-width: 46ch; font-size: 16px; line-height: 1.55; color: rgba(18,18,18,.78); }\n  .ccw__badge { display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; padding: 10px 16px 10px 12px; background: #fff; border-radius: 999px; box-shadow: 0 1px 2px rgba(18,18,18,.06), 0 6px 18px rgba(18,18,18,.06); color: inherit; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }\n  .ccw__badge b { font-size: 24px; line-height: 1; }\n  .ccw__badge small { display: block; font-size: 12.5px; color: rgba(18,18,18,.65); line-height: 1.3; }\n  .ccw__stars { color: #d4af37; letter-spacing: 1.5px; font-size: 15px; line-height: 1; }\n  .ccw__link { display: inline-block; margin-top: 14px; font-size: 14.5px; font-weight: 600; color: #c8322b; text-decoration: none; }\n  .ccw__link:hover { text-decoration: underline; text-underline-offset: 3px; }\n\n  /* reviews */\n  .ccw__reviews { position: relative; margin-top: 22px; }\n  .ccw__track { display: flex; gap: 14px; margin: 0 -18px; padding: 4px 18px 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 18px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }\n  .ccw__track::-webkit-scrollbar { display: none; }\n  .ccw__q { flex: 0 0 82%; max-width: 360px; scroll-snap-align: start; margin: 0; background: #fff; border-radius: 12px; padding: 20px 20px 16px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 1px 2px rgba(18,18,18,.05), 0 8px 22px rgba(18,18,18,.06); }\n  .ccw__q::before { content: \"\\201C\"; font-family: Georgia, \"Times New Roman\", serif; font-size: 44px; line-height: .6; height: 18px; color: #c8322b; }\n  .ccw__q p { margin: 0; font-size: 15.5px; line-height: 1.55; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }\n  .ccw__who { margin-top: auto; padding-top: 10px; display: flex; align-items: center; gap: 10px; border-top: 1px solid rgba(18,18,18,.07); }\n  .ccw__av { flex: 0 0 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: rgba(200,50,43,.1); color: #c8322b; font-weight: 700; font-size: 14px; }\n  .ccw__meta { font-size: 13px; line-height: 1.35; color: rgba(18,18,18,.65); }\n  .ccw__meta strong { display: block; font-size: 14px; color: #121212; }\n  .ccw__meta .ccw__stars { font-size: 12px; margin-right: 4px; }\n  .ccw__nav { display: none; }\n\n  /* shops */\n  .ccw__shops { display: flex; gap: 12px; margin: 8px -18px 0; padding: 14px 18px 4px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 18px; scrollbar-width: none; border-top: 1px solid rgba(18,18,18,.08); }\n  .ccw__shops::-webkit-scrollbar { display: none; }\n  .ccw__shop { flex: 0 0 76%; max-width: 340px; scroll-snap-align: start; display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-radius: 12px; color: inherit; text-decoration: none; transition: background .2s ease; }\n  .ccw__shop:hover { background: rgba(18,18,18,.04); }\n  .ccw__pin { flex: 0 0 36px; height: 36px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 1px 2px rgba(18,18,18,.08); }\n  .ccw__pin svg { width: 18px; height: 18px; fill: #c8322b; }\n  .ccw__txt b { display: block; font-size: 15.5px; line-height: 1.3; }\n  .ccw__txt span { display: block; font-size: 13.5px; line-height: 1.45; color: rgba(18,18,18,.68); }\n  .ccw__txt em { display: block; margin-top: 4px; font-style: normal; font-size: 13.5px; font-weight: 600; color: #c8322b; }\n  .ccw__note { margin: 10px 0 0; font-size: 12px; color: rgba(18,18,18,.5); }\n  .ccw a:focus-visible, .ccw button:focus-visible, .ccw__track:focus-visible { outline: 2px solid #c8322b; outline-offset: 3px; }\n\n  @media (hover: hover) { .ccw__badge:hover { transform: translateY(-1px); box-shadow: 0 2px 4px rgba(18,18,18,.08), 0 10px 24px rgba(18,18,18,.09); } }\n\n  @media (min-width: 990px) {\n    .ccw__panel { padding: 44px 48px 28px; }\n    .ccw__main { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.5fr); gap: 48px; align-items: center; }\n    .ccw h2 { font-size: 40px; }\n    .ccw__lead { font-size: 17px; }\n    .ccw__reviews { margin-top: 0; }\n    .ccw__track { margin: 0; padding: 6px 4px 16px; scroll-padding-left: 4px; }\n    .ccw__q { flex-basis: calc(50% - 7px); max-width: none; }\n    .ccw__q p { -webkit-line-clamp: 5; }\n    .ccw__nav { display: flex; gap: 8px; position: absolute; right: 4px; top: -46px; }\n    .ccw__nav button { width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(18,18,18,.16); background: #fff; color: #121212; font-size: 18px; line-height: 1; cursor: pointer; transition: background .2s ease, color .2s ease, border-color .2s ease; }\n    .ccw__nav button:hover { background: #121212; color: #fff; border-color: #121212; }\n    .ccw__shops { margin: 26px 0 0; padding: 20px 0 0; overflow: visible; display: grid; grid-template-columns: repeat(3, 1fr); }\n    .ccw__shop { max-width: none; }\n  }\n  @media (prefers-reduced-motion: no-preference) { .ccw__track { scroll-behavior: smooth; } }\n</style>\n\n<div class=\"ccw\">\n  <div class=\"ccw__panel\">\n    <div class=\"ccw__main\">\n      <div>\n        <p class=\"ccw__eyebrow\">A Leeds family business</p>\n        <h2>Why shop with us</h2>\n        <p class=\"ccw__lead\">We are a family, and our customers are our neighbours. You will find us in three Leeds shops and at local events, glad to help.</p>\n        <a class=\"ccw__badge\" href=\"https://www.google.com/maps/place/?q=place_id:ChIJ_5jc6wlceUgRo_t7u41q3Dw\" target=\"_blank\" rel=\"noopener\">\n          <b>4.6</b>\n          <span>\n            <span class=\"ccw__stars\" role=\"img\" aria-label=\"4.6 out of 5 stars\">★★★★★</span>\n            <small>148 Google reviews · Chapeltown Road</small>\n          </span>\n        </a>\n        <br>\n        <a class=\"ccw__link\" href=\"/blogs/news\">Read our community news →</a>\n      </div>\n\n      <div class=\"ccw__reviews\">\n        <div class=\"ccw__nav\" aria-hidden=\"true\">\n          <button type=\"button\" data-ccw=\"-1\" tabindex=\"-1\">‹</button>\n          <button type=\"button\" data-ccw=\"1\" tabindex=\"-1\">›</button>\n        </div>\n        <div class=\"ccw__track\" tabindex=\"0\" role=\"group\" aria-label=\"Customer reviews. Swipe to see more.\">\n          <blockquote class=\"ccw__q\">\n            <p>Great customer service! The French Curl Braids in colour 33 that I wanted were sold out, but the owner was so helpful and rang another branch to get them for me. I really appreciated them going out of their way to help. Really friendly and helpful.</p>\n            <footer class=\"ccw__who\"><span class=\"ccw__av\" aria-hidden=\"true\">E</span><span class=\"ccw__meta\"><strong>Eli A.</strong><span class=\"ccw__stars\" role=\"img\" aria-label=\"5 out of 5 stars\">★★★★★</span> Google review, September 2026</span></footer>\n          </blockquote>\n          <blockquote class=\"ccw__q\">\n            <p>Excellent customer service and a lovely, friendly team. The staff are always cheerful and have a great sense of humour, making every visit enjoyable. The owners are incredibly kind and welcoming…</p>\n            <footer class=\"ccw__who\"><span class=\"ccw__av\" aria-hidden=\"true\">K</span><span class=\"ccw__meta\"><strong>Kay R.</strong><span class=\"ccw__stars\" role=\"img\" aria-label=\"5 out of 5 stars\">★★★★★</span> Google review, June 2026</span></footer>\n          </blockquote>\n          <blockquote class=\"ccw__q\">\n            <p>excellent customer service. the manager is great and friendly. prices are great</p>\n            <footer class=\"ccw__who\"><span class=\"ccw__av\" aria-hidden=\"true\">A</span><span class=\"ccw__meta\"><strong>Aaliyah R.</strong><span class=\"ccw__stars\" role=\"img\" aria-label=\"5 out of 5 stars\">★★★★★</span> Google review, September 2026</span></footer>\n          </blockquote>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ccw__shops\" tabindex=\"0\" role=\"group\" aria-label=\"Our three Leeds shops. Swipe to see more.\">\n      <a class=\"ccw__shop\" href=\"https://www.google.com/maps/dir/?api=1&destination=CC+Hair+And+Beauty+Chapeltown+Road+Leeds&destination_place_id=ChIJ_5jc6wlceUgRo_t7u41q3Dw\" target=\"_blank\" rel=\"noopener\">\n        <span class=\"ccw__pin\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.800 7-13a7 7 0 0 0-7-7zm0 9.500A2.500 2.500 0 1 1 12 6.500a2.500 2.500 0 0 1 0 5z\"/></svg></span>\n        <span class=\"ccw__txt\"><b>Chapeltown Road</b><span>119 Chapeltown Road, Leeds LS7 3HY</span><span>4.6 ★ from 148 reviews</span><em>Get directions →</em></span>\n      </a>\n      <a class=\"ccw__shop\" href=\"https://www.google.com/maps/dir/?api=1&destination=CC+Hair+And+Beauty+Roundhay+Road+Leeds&destination_place_id=ChIJSwvcAYlbeUgRT7wTEeJy25A\" target=\"_blank\" rel=\"noopener\">\n        <span class=\"ccw__pin\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.800 7-13a7 7 0 0 0-7-7zm0 9.500A2.500 2.500 0 1 1 12 6.500a2.500 2.500 0 0 1 0 5z\"/></svg></span>\n        <span class=\"ccw__txt\"><b>Roundhay Road</b><span>256 Roundhay Road, Leeds LS8 5RL</span><span>4.5 ★ from 292 reviews</span><em>Get directions →</em></span>\n      </a>\n      <a class=\"ccw__shop\" href=\"https://www.google.com/maps/dir/?api=1&destination=CC+Hair+And+Beauty+City+Centre+Leeds&destination_place_id=ChIJqTbKkhlceUgRcbg1e3Z7Ezo\" target=\"_blank\" rel=\"noopener\">\n        <span class=\"ccw__pin\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.800 7-13a7 7 0 0 0-7-7zm0 9.500A2.500 2.500 0 1 1 12 6.500a2.500 2.500 0 0 1 0 5z\"/></svg></span>\n        <span class=\"ccw__txt\"><b>Leeds city centre</b><span>1-19 New York Street, Leeds LS2 7DT</span><span>4.4 ★ from 120 reviews</span><em>Get directions →</em></span>\n      </a>\n    </div>\n    <p class=\"ccw__note\">Google ratings as shown on 7 October 2026.</p>\n  </div>\n</div>\n<script>\n  (function () {\n    var root = document.currentScript.previousElementSibling;\n    var track = root && root.querySelector('.ccw__track');\n    if (!track) return;\n    root.querySelectorAll('[data-ccw]').forEach(function (b) {\n      b.addEventListener('click', function () {\n        var card = track.querySelector('.ccw__q');\n        track.scrollBy({ left: Number(b.dataset.ccw) * ((card ? card.offsetWidth : 300) + 14), behavior: 'smooth' });\n      });\n    });\n  })();\n</script>"}},"rich_text_RiJTxg":{"type":"rich-text","blocks":{"heading_YYmq78":{"type":"heading","settings":{"heading":"Afro Hair and Beauty Products in Leeds","heading_size":"h1"}},"text_M393VF":{"type":"text","settings":{"text":"<p>CC Hair and Beauty has been Leeds' trusted afro hair and beauty destination since 1979. Based on Chapeltown Road LS7, we stock over 9,000 products from 1,000+ brands, all genuine and dispatched from our Leeds warehouse. Shop braiding hair, wigs, relaxers, skin care and makeup. Free UK delivery over £75. Next-day delivery available. Local delivery to LS7, LS8 and LS9. Visit us at 121–129 Chapeltown Road, Leeds LS7 3DU. Open Monday to Sunday, 9am–8pm. Call <a href=\"tel:+441132495562\">0113 249 5562</a>.</p><p>Whether you're looking for Organic Root Stimulator, Dark and Lovely, Cantu, Eco Styler, LA Girl, Xpression, Got2b, Blue Magic, Nicka K New York or Absolute New York, you'll find it here at prices that beat the supermarkets and online marketplaces, with same-day collection available from our Chapeltown, Roundhay and City Centre Leeds branches.</p>"}}},"block_o