<style>
.nba{padding:24px 0}
.nba-h{position:relative;text-align:center;margin:0 0 28px}
.nba h2{font-size:32px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;margin:0;padding:0 0 18px;position:relative;display:inline-block}
.nba h2:after{content:"";position:absolute;left:50%;bottom:0;width:70px;height:4px;margin-left:-35px;background:#c8322b}
.nba-a{display:flex;gap:8px;position:absolute;right:0;top:0}
.nba-a button{width:42px;height:42px;border-radius:50%;border:1px solid currentColor;background:none;color:inherit;font-size:24px;line-height:1;cursor:pointer;padding:0 0 3px}
.nba-g{display:flex;flex-wrap:nowrap;gap:1.25%;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
.nba-g::-webkit-scrollbar{display:none}
.nba-g a{flex:0 0 19%;width:19%;max-width:19%;min-width:0;scroll-snap-align:start;display:block;text-decoration:none;color:inherit;text-align:center}
.nba-g a[data-nba-extra]{display:none}
.nba-i{display:block;aspect-ratio:1/1;border-radius:14px;overflow:hidden;background:#f3f4f8;margin:0 0 8px}
.nba-i img{width:100%;height:100%;object-fit:cover;display:block}
.nba-t{display:block;font-size:1.5rem;font-weight:700;line-height:1.3}
@media screen and (max-width:989px){.nba-g a{flex:0 0 30%;width:30%;max-width:30%}}
@media screen and (max-width:749px){
  .nba h2{font-size:22px}
  .nba-a{position:static;justify-content:center;margin-top:12px}
  .nba-g{gap:4%}
  .nba-g a{flex:0 0 46%;width:46%;max-width:46%}
}
</style>
{%- assign max = section.settings.max | default: 15 -%}
{%- assign shown = 0 -%}
<div class="nba page-width">
  <div class="nba-h">
    <h2>New Brands Arrival</h2>
    <div class="nba-a">
      <button type="button" aria-label="Scroll left" onclick="var t=this.closest('.nba').querySelector('.nba-g');t.scrollBy({left:-t.clientWidth*0.8,behavior:'smooth'})">&#8249;</button>
      <button type="button" aria-label="Scroll right" onclick="var t=this.closest('.nba').querySelector('.nba-g');t.scrollBy({left:t.clientWidth*0.8,behavior:'smooth'})">&#8250;</button>
    </div>
  </div>
  <div class="nba-g" id="nba-g-{{ section.id }}">
    {%- for link in linklists['new-brands-arrival'].links limit: 40 -%}
      {%- assign c = link.object -%}
      {%- if link.type == 'collection_link' and c.image -%}
        {%- assign shown = shown | plus: 1 -%}
        <a href="{{ link.url }}"{% if shown > max %}{% if section.settings.shuffle == false %} hidden{% endif %} data-nba-extra{% endif %}>
          <span class="nba-i">
            <img src="{{ c.image | image_url: width: 400 }}" alt="{{ c.title | escape }}" loading="lazy" width="400" height="400">
          </span>
          <span class="nba-t">{{ link.title }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.shuffle != false -%}
  <script>
    (function () {
      var g = document.getElementById('nba-g-{{ section.id }}');
      if (!g) return;
      var keep = {{ section.settings.pin | default: 0 }}, max = {{ max }};
      var items = Array.prototype.slice.call(g.children);
      var pinned = items.slice(0, keep), rest = items.slice(keep);
      for (var i = rest.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = rest[i]; rest[i] = rest[j]; rest[j] = t; }
      pinned.concat(rest).forEach(function (a, n) {
        if (n < max) a.removeAttribute('data-nba-extra'); else a.setAttribute('data-nba-extra', '');
        g.appendChild(a);
      });
    })();
  </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "New Brands Arrival",
  "settings": [
    { "type": "range", "id": "max", "min": 5, "max": 30, "step": 1, "default": 15, "label": "Brands to show" },
    { "type": "checkbox", "id": "shuffle", "default": true, "label": "Show a different mix on every visit", "info": "Brands come from the New Brands Arrival menu" },
    { "type": "range", "id": "pin", "min": 0, "max": 6, "step": 1, "default": 2, "label": "Keep the first brands fixed", "info": "The newest brands sit at the front of the menu each morning; these stay put and the rest are shuffled" }
  ],
  "presets": [{ "name": "New Brands Arrival" }]
}
{% endschema %}
