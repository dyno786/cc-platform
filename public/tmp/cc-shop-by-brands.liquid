{%- comment -%}
  CC Hair & Beauty – Shop by Brands (same look as the theme's Collection list section)
  Brands come from the navigation menu "Shop By Brands" (Online Store > Navigation).
  Only collection links whose collection has an image are shown. Claude reorders the menu each morning.
{%- endcomment -%}
{%- assign menu_handle = section.settings.menu | default: 'shop-by-brands' -%}
{%- assign brand_links = linklists[menu_handle].links -%}
{%- assign count = 0 -%}
{%- for link in brand_links -%}
  {%- if link.type == 'collection_link' and link.object.featured_image != blank and count < section.settings.max -%}
    {%- assign count = count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
<style>
  #ccsb-{{ section.id }} .ccsb-top{position:relative}
  #ccsb-{{ section.id }} .ccsb-arrows{display:flex;gap:8px;position:absolute;right:0;top:50%;transform:translateY(-50%)}
  #ccsb-{{ section.id }} .ccsb-arrows button{width:42px;height:42px;border-radius:50%;border:1px solid currentColor;background:none;color:inherit;font-size:24px;line-height:1;cursor:pointer;padding:0 0 3px}
  #ccsb-{{ section.id }} .ccsb-track{display:flex;flex-wrap:nowrap;gap:1.2rem;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;list-style:none;margin:0;padding:0}
  #ccsb-{{ section.id }} .ccsb-track::-webkit-scrollbar{display:none}
  #ccsb-{{ section.id }} .ccsb-track > li{flex:0 0 calc((100% - 4 * 1.2rem) / 5);max-width:calc((100% - 4 * 1.2rem) / 5);min-width:0;scroll-snap-align:start;width:auto;padding:0}
  @media screen and (max-width:989px){#ccsb-{{ section.id }} .ccsb-track > li{flex-basis:calc((100% - 2 * 1.2rem) / 3);max-width:calc((100% - 2 * 1.2rem) / 3)}}
  @media screen and (max-width:749px){
    #ccsb-{{ section.id }} .ccsb-arrows{position:static;transform:none;justify-content:center;margin-top:12px}
    #ccsb-{{ section.id }} .ccsb-track > li{flex-basis:44%;max-width:44%}
  }
</style>

<div id="ccsb-{{ section.id }}" class="collection-list-wrapper page-width{% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false %} no-mobile-link{% endif %}">
  <div class="ccsb-top title-wrapper-with-link{% if section.settings.title == blank %} title-wrapper-with-link--no-heading{% endif %}">
    <h2 class="collection-list-title">{{ section.settings.title | escape }}</h2>
    <div class="ccsb-arrows">
      <button type="button" aria-label="Scroll left" onclick="var t=document.getElementById('ccsb-track-{{ section.id }}');t.scrollBy({left:-t.clientWidth*0.8,behavior:'smooth'})">&#8249;</button>
      <button type="button" aria-label="Scroll right" onclick="var t=document.getElementById('ccsb-track-{{ section.id }}');t.scrollBy({left:t.clientWidth*0.8,behavior:'smooth'})">&#8250;</button>
    </div>
  </div>

  <div>
    <ul class="collection-list ccsb-track" id="ccsb-track-{{ section.id }}" role="list">
      {%- liquid
        assign columns = count
        if columns > 3
          assign columns = 3
        endif
        assign shown = 0
      -%}
      {%- for link in brand_links -%}
        {%- assign collection = link.object -%}
        {%- if link.type == 'collection_link' and collection.featured_image != blank and shown < section.settings.max -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="collection-list__item">
            <a href="{{ collection.url }}"
              class="card animate-arrow link card--media{% unless section.settings.image_padding %} card--light-border{% endunless %}"
            >
              <div class="card--stretch card-colored color-{{ section.settings.color_scheme }}">
                <div{% if section.settings.image_padding %} class="card__media-spacer"{% endif %}>
                  {% if section.settings.image_padding %}<div class="overlay-card"></div>{% endif %}
                  <div class="media{% if count > 1 %} media--{{ section.settings.image_ratio }}{% endif %} media--hover-effect overflow-hidden"
                    {% if section.settings.image_ratio == 'adapt' and count > 1 %}style="padding-bottom: {{ 1 | divided_by: collection.featured_image.aspect_ratio | times: 100 }}%;"{% endif %}>
                    <img
                      srcset="{%- if collection.featured_image.width >= 165 -%}{{ collection.featured_image | img_url: '165x' }} 165w,{%- endif -%}
                        {%- if collection.featured_image.width >= 330 -%}{{ collection.featured_image | img_url: '330x' }} 330w,{%- endif -%}
                        {%- if collection.featured_image.width >= 535 -%}{{ collection.featured_image | img_url: '535x' }} 535w,{%- endif -%}
                        {%- if collection.featured_image.width >= 750 -%}{{ collection.featured_image | img_url: '750x' }} 750w,{%- endif -%}
                        {%- if collection.featured_image.width >= 1000 -%}{{ collection.featured_image | img_url: '1000x' }} 1000w,{%- endif -%}
                        {{ collection.featured_image | img_url: 'master' }} {{ collection.featured_image.width }}w"
                      src="{{ collection.featured_image | img_url: '1000x' }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px, (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 3rem)"
                      alt="{{ link.title | escape }}"
                      height="{{ collection.featured_image.height }}"
                      width="{{ collection.featured_image.width }}"
                      loading="lazy"
                      class="motion-reduce"
                    >
                  </div>
                </div>
                <div class="card__text card__text-spacing card-colored card__text-hover{% if section.settings.image_padding == false %} color-{{ section.settings.color_scheme }}{% endif %}">
                  {% unless section.settings.image_padding %}<div class="overlay-card"></div>{% endunless %}
                  <h3>{{- link.title | escape -}}<span class="icon-wrap">&nbsp;{% render 'icon-arrow' %}</span></h3>
                </div>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  </div>

  {%- if section.settings.show_view_all -%}
    <div class="center" style="margin-top:2rem">
      <a href="{{ section.settings.view_all_link | default: '/pages/brands' }}" class="button">{{ 'sections.collection_list.view_all' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CC: Shop by brands",
  "tag": "section",
  "class": "spaced-section collection-list-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Brands menu", "info": "Leave empty to use the \"Shop By Brands\" menu" },
    { "type": "range", "id": "max", "min": 3, "max": 24, "step": 1, "default": 12, "label": "Brands to show" },
    { "type": "text", "id": "title", "default": "Shop By Brands", "label": "Heading" },
    { "type": "select", "id": "image_ratio", "options": [ { "value": "adapt", "label": "Adapt to image" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" } ], "default": "square", "label": "Image ratio" },
    { "type": "select", "id": "color_scheme", "options": [ { "value": "accent-1", "label": "Accent 1" }, { "value": "accent-2", "label": "Accent 2" }, { "value": "background-1", "label": "Background 1" }, { "value": "background-2", "label": "Background 2" }, { "value": "inverse", "label": "Inverse" } ], "default": "accent-2", "label": "Colour scheme" },
    { "type": "checkbox", "id": "image_padding", "default": false, "label": "Add image padding" },
    { "type": "checkbox", "id": "show_view_all", "default": false, "label": "Show \"View all\" button" },
    { "type": "url", "id": "view_all_link", "label": "\"View all\" link", "info": "Defaults to the Brands page" }
  ],
  "presets": [ { "name": "CC: Shop by brands" } ]
}
{% endschema %}
