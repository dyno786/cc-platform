{%- comment -%}
  CC Hair & Beauty – Shop by Brands
  Shows brand tiles from a navigation menu (default: "shop-by-brands").
  Change the brands in Online Store > Navigation > Shop By Brands.
  Only collection links with a collection image are shown. Claude reorders the menu each morning.
{%- endcomment -%}
{%- assign menu_handle = section.settings.menu | default: 'shop-by-brands' -%}
{%- assign menu = linklists[menu_handle] -%}
{%- assign shown = 0 -%}
<style>
  .ccsb-{{ section.id }}{padding:{{ section.settings.pad }}px 0}
  .ccsb-{{ section.id }} .ccsb-h{text-align:center;margin:0 0 24px}
  .ccsb-{{ section.id }} h2{font-size:22px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;margin:0;padding:0 0 14px;position:relative;display:inline-block}
  .ccsb-{{ section.id }} h2:after{content:"";position:absolute;left:50%;bottom:0;width:60px;height:3px;margin-left:-30px;background:{{ section.settings.accent }}}
  .ccsb-{{ section.id }} .ccsb-g{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 5 * 12px) / 6);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}
  .ccsb-{{ section.id }} .ccsb-g::-webkit-scrollbar{display:none}
  .ccsb-{{ section.id }} a.ccsb-t{scroll-snap-align:start;display:flex;flex-direction:column;text-decoration:none;color:inherit;border:1px solid #e8e8e8;background:#fff;min-width:0}
  .ccsb-{{ section.id }} .ccsb-i{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;padding:12px;background:#fff}
  .ccsb-{{ section.id }} .ccsb-i img{max-width:100%;max-height:100%;object-fit:contain;display:block}
  .ccsb-{{ section.id }} .ccsb-n{background:{{ section.settings.accent }};color:#fff;font-size:13px;font-weight:600;padding:10px 12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ccsb-{{ section.id }} .ccsb-n:after{content:" \2192"}
  .ccsb-{{ section.id }} .ccsb-all{text-align:center;margin-top:20px}
  .ccsb-{{ section.id }} .ccsb-all a{display:inline-block;background:#111;color:#fff;padding:10px 22px;font-size:13px;font-weight:600;text-decoration:none}
  @media screen and (max-width:989px){.ccsb-{{ section.id }} .ccsb-g{grid-auto-columns:calc((100% - 3 * 12px) / 4)}}
  @media screen and (max-width:749px){.ccsb-{{ section.id }} .ccsb-g{grid-auto-columns:42%}}
</style>
<div class="ccsb-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="ccsb-h"><h2>{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
    <div class="ccsb-g">
      {%- for link in menu.links -%}
        {%- if shown >= section.settings.max -%}{%- break -%}{%- endif -%}
        {%- assign c = link.object -%}
        {%- if link.type == 'collection_link' and c.image -%}
          {%- assign shown = shown | plus: 1 -%}
          <a class="ccsb-t" href="{{ link.url }}">
            <span class="ccsb-i"><img src="{{ c.image | image_url: width: 400 }}" alt="{{ link.title | escape }}" loading="lazy" width="400" height="400"></span>
            <span class="ccsb-n">{{ link.title | escape }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.all_label != blank -%}
      <div class="ccsb-all"><a href="{{ section.settings.all_link | default: '/pages/brands' }}">{{ section.settings.all_label | escape }}</a></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CC: Shop by brands",
  "tag": "section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Brands menu", "info": "Leave empty to use the \"Shop By Brands\" menu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Brands" },
    { "type": "range", "id": "max", "min": 4, "max": 24, "step": 1, "default": 12, "label": "Brands to show" },
    { "type": "text", "id": "all_label", "label": "Button label", "default": "View all brands" },
    { "type": "url", "id": "all_link", "label": "Button link" },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#C8322E" },
    { "type": "range", "id": "pad", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32, "label": "Space above and below" }
  ],
  "presets": [ { "name": "CC: Shop by brands" } ]
}
{% endschema %}
